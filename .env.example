# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead.

# Required. A Postgres database.
DATABASE_URL=postgres://user:password@localhost:5432/calendi

# Required. At least 32 characters; generate with: openssl rand -base64 32
# Signs sessions and encrypts stored calendar credentials. Do not change it
# once calendars are connected.
APP_SECRET=

# Optional. The public address, if it should not be taken from the request.
# APP_URL=https://meet.example.com

# Optional. Everything below can be entered in the admin instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# EMAIL_FROM=meetings@example.com
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CALENDAR_CACHE_SECONDS=60
