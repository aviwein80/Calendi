# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead.

# Required. A Postgres database.
DATABASE_URL=postgres://user:password@localhost:5432/calendi

# Required. At least 32 characters; generate with: openssl rand -base64 32
# Signs sessions and encrypts stored calendar credentials. Do not change it
# once calendars are connected.
APP_SECRET=

# Required until the owner account exists. At least 24 characters; generate
# the same way. Whoever first submits the setup form with this value becomes
# the owner, so keep it private. It can be removed once your account exists.
SETUP_TOKEN=

# Optional. The public address, if it should not be taken from the request.
# APP_URL=https://meet.example.com

# Needed for "Connect Google" / "Connect Outlook / Microsoft 365". The
# Calendars page shows how to get them (a one-time app registration).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# Optional. Email can be entered in the admin instead.
# EMAIL_FROM=meetings@example.com
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CALENDAR_CACHE_SECONDS=60
# MIGRATE_ON_PREVIEW=1   # only if Vercel previews have their own database
